// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MÓDULO DE AUTENTICACIÓN Y ROLES
// ==========================================

model Usuario {
  id        Int       @id @default(autoincrement())
  nombre    String
  apellido  String?
  correo    String?   @unique @map("email") // Nullable desde Sprint 2: estudiantes pueden no tener correo institucional
  password  String    @map("password_hash")
  telefono  String?
  sessionId String?   @map("session_id")
  deletedAt DateTime? @map("deleted_at") @db.Timestamp()
  debeCambiarPassword Boolean @default(false) @map("debe_cambiar_password")
  debeConfigurarPerfil Boolean @default(true) @map("debe_configurar_perfil")

  roles              Usuario_Rol[]
  alcances           Usuario_Alcance[]
  examenes           Examen[]                @relation("ResponsableExamen")
  reservas           ReservaAmbiente[]       @relation("DocenteReserva")
  cargasEstudiantes  CargaEstudiantes[]      @relation("UsuarioCarga")
  ingresos           Ingreso[]               @relation("UsuarioRegistra")
  auditorias         Bitacora_Auditoria[]
  tokensRecuperacion TokenRecuperacion[]
  estudiante         Estudiante?             @relation("UsuarioEstudiante")
  // HU13: colaboraciones como docente y como colaborador
  colaboradoresComoDocente   DocenteColaborador[] @relation("DocenteSolicita")
  colaboradoresComoAuxiliar  DocenteColaborador[] @relation("ColaboradorAuxiliar")
  colaboradoresAprobados     DocenteColaborador[] @relation("AdminAprueba")
  examenesControlados        ExamenControlador[]  @relation("ColaboradorControla")
  examenesAsignados          ExamenControlador[]  @relation("DocenteAsigna")
  incidenciasRegistradas     IncidenciaIngreso[]  @relation("ControlRegistraIncidencia")

  @@map("usuarios")
}

model Modulo {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activo Boolean @default(true)

  permisos    Permiso[]
  rolesModulo Rol_Modulo[]

  @@map("modulos")
}

model Permiso {
  id          Int     @id @default(autoincrement())
  moduloId    Int     @map("modulo_id")
  clave       String  @unique
  descripcion String?

  modulo Modulo        @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  roles  Rol_Permiso[]

  @@map("permisos")
}

model Rol {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique
  descripcion String?
  esPlantilla Boolean   @default(false) @map("es_plantilla")
  deletedAt   DateTime? @map("deleted_at")

  permisos Rol_Permiso[]
  usuarios Usuario_Rol[]
  modulos  Rol_Modulo[]

  @@map("roles")
}

model Rol_Permiso {
  rolId     Int @map("rol_id")
  permisoId Int @map("permiso_id")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("rol_permiso")
}

model Usuario_Rol {
  usuarioId Int @map("usuario_id")
  rolId     Int @map("rol_id")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@map("usuario_rol")
}

model Rol_Modulo {
  rolId    Int @map("rol_id")
  moduloId Int @map("modulo_id")

  rol    Rol    @relation(fields: [rolId], references: [id], onDelete: Cascade)
  modulo Modulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@id([rolId, moduloId])
  @@map("rol_modulo")
}

// ==========================================
// MÓDULO ACADÉMICO Y ALCANCE
// ==========================================

model Facultad {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  carreras  Carrera[]
  ambientes Ambiente[]
  alcances  Usuario_Alcance[]

  @@map("facultades")
}

model Carrera {
  id         Int    @id @default(autoincrement())
  facultadId Int    @map("id_facultad")
  nombre     String

  facultad Facultad          @relation(fields: [facultadId], references: [id], onDelete: Cascade)
  materias Carrera_Materia[]
  alcances Usuario_Alcance[]

  @@map("carreras")
}

model Materia {
  id     Int     @id @default(autoincrement())
  sigla  String?
  nombre String

  carreras Carrera_Materia[]
  alcances Usuario_Alcance[]

  @@map("materias")
}

model Carrera_Materia {
  carreraId Int @map("id_carrera")
  materiaId Int @map("id_materia")

  carrera  Carrera                  @relation(fields: [carreraId], references: [id], onDelete: Cascade)
  materia  Materia                  @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  examenes Examen_Carrera_Materia[]

  @@id([carreraId, materiaId])
  @@map("carrera_materia")
}

model Usuario_Alcance {
  id         Int  @id @default(autoincrement())
  usuarioId  Int  @map("id_usuario")
  facultadId Int? @map("id_facultad")
  carreraId  Int? @map("id_carrera")
  materiaId  Int? @map("id_materia")

  usuario  Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  facultad Facultad? @relation(fields: [facultadId], references: [id], onDelete: Cascade)
  carrera  Carrera?  @relation(fields: [carreraId], references: [id], onDelete: Cascade)
  materia  Materia?  @relation(fields: [materiaId], references: [id], onDelete: Cascade)

  @@map("usuario_alcance")
}

// ==========================================
// MÓDULO DE RESERVAS Y AMBIENTES
// ==========================================

model TipoAula {
  id     Int    @id @default(autoincrement())
  nombre String

  ambientes Ambiente[]

  @@map("tipo_aula")
}

enum EstadoAula {
  DISPONIBLE
  RESERVADO
  MANTENIMIENTO
  INHABILITADO
  EN_REMODELACION // Sprint 2: nuevo estado
}

enum EstadoReserva {
  RESERVADO
  CANCELADO
  FINALIZADO
}

model Ambiente {
  id         Int        @id @default(autoincrement())
  nombre     String
  capacidad  Int
  facultadId Int?       @map("id_facultad")
  tipoAulaId Int?       @map("id_tipoAula")
  estadoAula EstadoAula @default(DISPONIBLE) // Sprint 2: campo directo, sin id_estadoAula redundante

  facultad Facultad?  @relation(fields: [facultadId], references: [id])
  tipoAula TipoAula?  @relation(fields: [tipoAulaId], references: [id])

  reservas ReservaAmbiente[]

  @@map("ambientes")
}

// Sprint 2: Malla horaria institucional predefinida
model HorarioFijo {
  id           Int    @id @default(autoincrement())
  periodoNombre String @map("periodo_nombre")
  diaSemana    String? @map("dia_semana") // null = aplica cualquier día
  horaIni      DateTime @map("hora_ini") @db.Time
  horaFin      DateTime @map("hora_fin") @db.Time

  reservas ReservaAmbiente[]

  @@map("horario_fijo")
}

// Sprint 2: ReservaAmbiente adaptado a periodos institucionales predefinidos
model ReservaAmbiente {
  id            Int           @id @default(autoincrement())
  ambienteId    Int           @map("ambiente_id")
  docenteId     Int           @map("docente_id") // renombrado de usuarioId para claridad
  horarioFijoId Int           @map("horario_fijo_id") // reemplaza hora_ini / hora_fin libres
  fecha         DateTime      @db.Date
  estado        EstadoReserva @default(RESERVADO)

  ambiente     Ambiente    @relation(fields: [ambienteId], references: [id], onDelete: Cascade)
  docente      Usuario     @relation("DocenteReserva", fields: [docenteId], references: [id], onDelete: Cascade)
  horarioFijo  HorarioFijo @relation(fields: [horarioFijoId], references: [id])

  examenes Examen[]

  @@map("reserva_ambiente")
}

// ==========================================
// MÓDULO DE EXÁMENES E INGRESOS
// ==========================================

enum EstadoExamen {
  PROGRAMADO
  EN_CURSO
  FINALIZADO
  CANCELADO
}

model Examen {
  id                Int          @id @default(autoincrement())
  reservaAmbienteId Int          @unique @map("id_reservaAmbiente") // Sprint 2: @unique — 1 examen por reserva
  usuarioId         Int          @map("id_usuario")
  tipoExamen        String       @map("tipo_examen")
  normasEx          String?      @map("normas_ex") @db.Text
  estadoExamId      Int          @map("id_EstadoExam")
  creadoEn          DateTime     @default(now()) @map("creado_en")
  fueEditado        Boolean      @default(false) @map("fue_editado")
  estado            EstadoExamen @default(PROGRAMADO)

  reservaAmbiente ReservaAmbiente @relation(fields: [reservaAmbienteId], references: [id])
  responsable     Usuario         @relation("ResponsableExamen", fields: [usuarioId], references: [id])

  carrerasMaterias  Examen_Carrera_Materia[]
  estudiantes       Examen_Estudiante[]
  ingresos          Ingreso[]
  controladores     ExamenControlador[]     // HU7/HU13
  incidencias       IncidenciaIngreso[]     // HU12

  @@map("examenes")
}

model Examen_Carrera_Materia {
  examenId  Int @map("id_examen")
  carreraId Int @map("id_carrera")
  materiaId Int @map("id_materia")

  examen          Examen          @relation(fields: [examenId], references: [id], onDelete: Cascade)
  carrera_materia Carrera_Materia @relation(fields: [carreraId, materiaId], references: [carreraId, materiaId], onDelete: Cascade)

  @@id([examenId, carreraId, materiaId])
  @@map("examen_carrera_materia")
}

// ==========================================
// MÓDULO DE ESTUDIANTES Y REGISTROS OPERATIVOS
// ==========================================

model CargaEstudiantes {
  id                Int      @id @default(autoincrement())
  archivoNombre     String   @map("archivo_nombre")
  fechaCarga        DateTime @map("fecha_carga") @db.Timestamp()
  cargadoPor        Int      @map("cargado_por")
  cantidadRegistros Int      @map("cantidad_registros")

  usuario     Usuario      @relation("UsuarioCarga", fields: [cargadoPor], references: [id])
  estudiantes Estudiante[]

  @@map("cargas_estudiantes")
}

model Estudiante {
  id       Int     @id @default(autoincrement())
  cod_sis  String  @unique // Sprint 2: garantizado único — evita duplicados en cargas masivas
  nombre   String
  apellido String?
  ci       String?
  cargaId  Int?    @map("carga_id")
  usuarioId Int?   @unique @map("usuario_id") // Sprint 2: FK 1:1 con Usuario — permite login por SIS+CI
  perfilCompleto Boolean @default(false) @map("perfil_completo")
  fotoUrl  String? @map("foto_url")
  qrVersion Int     @default(1) @map("qr_version")
  telefono String?

  carga     CargaEstudiantes?   @relation(fields: [cargaId], references: [id])
  usuario   Usuario?            @relation("UsuarioEstudiante", fields: [usuarioId], references: [id])
  examenes  Examen_Estudiante[]
  codigosQr CodigoQr[]
  ingresos  Ingreso[]
  incidencias IncidenciaIngreso[] // HU12: incidencias asociadas al estudiante
  fotos     FotoEstudiante[]

  @@map("estudiantes")
}

model FotoEstudiante {
  id           Int      @id @default(autoincrement())
  estudianteId Int      @map("estudiante_id")
  archivo      String   // nombre generado por el servidor
  hashSha256   String   @map("hash_sha256")
  estado       String   @default("ACTIVA") // ACTIVA | REEMPLAZADA | RECHAZADA | PENDIENTE
  similitud    Float?   // puntaje de la comparación (sprint 3)
  creadaEn     DateTime @default(now()) @map("creada_en")

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@index([estudianteId, estado])
  @@map("fotos_estudiante")
}


model Examen_Estudiante {
  estudianteId          Int     @map("id_estudiante")
  examenId              Int     @map("id_examen")
  estado_habilitado     Boolean @default(true)
  motivo_inhabilitacion String? @db.Text

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  examen     Examen     @relation(fields: [examenId], references: [id], onDelete: Cascade)

  @@id([estudianteId, examenId])
  @@map("examen_estudiante")
}

model CodigoQr {
  id           Int      @id @default(autoincrement())
  estudianteId Int      @map("estudiante_id")
  token        String   @unique
  generadoEn   DateTime @map("generado_en") @db.Timestamp()
  expiraEn     DateTime @map("expira_en") @db.Timestamp()

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@map("codigos_qr")
}

// Sprint 2: campos offline para sincronización (HU14)
model Ingreso {
  id             Int      @id @default(autoincrement())
  estudianteId   Int      @map("estudiante_id")
  examenId       Int      @map("examen_id")
  fechaHora      DateTime @map("fecha_hora") @db.Timestamp()
  metodo         String
  registradoPor  Int      @map("registrado_por")
  clienteSyncId  String?  @unique @map("cliente_sync_id") // UUID generado offline para idempotencia
  esOffline      Boolean  @default(false) @map("es_offline")

  estudiante Estudiante @relation(fields: [estudianteId], references: [id])
  examen     Examen     @relation(fields: [examenId], references: [id])
  usuario    Usuario    @relation("UsuarioRegistra", fields: [registradoPor], references: [id])

  @@map("ingresos")
}

// ==========================================
// MÓDULO DE PERSONAL DE CONTROL (Sprint 2)
// ==========================================

enum EstadoSolicitud {
  PENDIENTE
  APROBADO
  RECHAZADO
  INACTIVO
}

// HU13: Plantilla fija de colaboradores del docente
model DocenteColaborador {
  id                   Int              @id @default(autoincrement())
  docenteId            Int              @map("id_docente")
  colaboradorId        Int?             @map("id_colaborador")
  estadoSolicitud      EstadoSolicitud  @default(PENDIENTE) @map("estado_solicitud")
  aprobadoPor          Int?             @map("aprobado_por")
  fechaSolicitud       DateTime         @default(now()) @map("fecha_solicitud") @db.Timestamp()
  fechaRespuesta       DateTime?        @map("fecha_respuesta") @db.Timestamp()
  // Correo guardado para el caso de que aún no exista Usuario al momento de solicitar
  correoSolicitado     String?          @map("correo_solicitado")
  nombresSolicitados   String?          @map("nombres_solicitados")
  apellidosSolicitados String?          @map("apellidos_solicitados")

  docente      Usuario  @relation("DocenteSolicita", fields: [docenteId], references: [id])
  colaborador  Usuario? @relation("ColaboradorAuxiliar", fields: [colaboradorId], references: [id])
  aprobador    Usuario? @relation("AdminAprueba", fields: [aprobadoPor], references: [id])

  @@map("docente_colaborador")
}

// HU7/HU13: Asignación operativa puntual de colaborador a examen
model ExamenControlador {
  id              Int      @id @default(autoincrement())
  examenId        Int      @map("id_examen")
  colaboradorId   Int      @map("id_colaborador")
  asignadoPor     Int      @map("asignado_por")
  fechaAsignacion DateTime @default(now()) @map("fecha_asignacion") @db.Timestamp()
  rolAsignacion   String   @default("Control principal") @map("rol_asignacion") // "Control principal" | "Apoyo de ingreso"

  examen      Examen  @relation(fields: [examenId], references: [id], onDelete: Cascade)
  colaborador Usuario @relation("ColaboradorControla", fields: [colaboradorId], references: [id])
  docente     Usuario @relation("DocenteAsigna", fields: [asignadoPor], references: [id])

  @@unique([examenId, colaboradorId]) // un colaborador no puede estar asignado dos veces al mismo examen
  @@map("examen_controlador")
}

enum TipoIncidencia {
  NO_HABILITADO       // El estudiante está registrado pero no figura en la lista del examen
  NO_ENCONTRADO       // El estudiante no existe en la base de datos
  QR_CADUCADO         // Intentó ingresar con un QR cuya validez ya expiró
  DOBLE_MARCACION     // Su QR ya fue escaneado anteriormente en otra puerta
  IDENTIDAD_NO_COINCIDE // Presentó un documento o código SIS que no corresponde a la persona
}

// HU12: Registro de intentos de acceso no autorizados
model IncidenciaIngreso {
  id                 Int            @id @default(autoincrement())
  examenId           Int            @map("id_examen")
  registradoPor      Int            @map("registrado_por")
  estudianteId       Int?           @map("id_estudiante")    // null si no figura en el sistema
  codSisIngresado    String?        @map("cod_sis_ingresado") // dato manual si no existe en BD
  ciIngresado        String?        @map("ci_ingresado")      // dato manual si no existe en BD
  nombreReferencial  String?        @map("nombre_referencial") // nombre que escribió el control (solo si no está en BD)
  tipoIncidencia     TipoIncidencia @map("tipo_incidencia")
  descripcion        String?        @db.Text
  fechaHora          DateTime       @default(now()) @map("fecha_hora") @db.Timestamp()

  examen      Examen      @relation(fields: [examenId], references: [id])
  controlador Usuario     @relation("ControlRegistraIncidencia", fields: [registradoPor], references: [id])
  estudiante  Estudiante? @relation(fields: [estudianteId], references: [id])

  @@map("incidencia_ingreso")
}

// ==========================================
// MÓDULO DE RECUPERACIÓN DE CONTRASEÑA
// ==========================================

model TokenRecuperacion {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  usuarioId Int      @map("id_usuario")
  usado     Boolean  @default(false)
  expiraEn  DateTime @map("expira_en") @db.Timestamp()
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamp()

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("token_recuperacion")
}

// ==========================================
// MÓDULO DE AUDITORÍA
// ==========================================

model Bitacora_Auditoria {
  id               Int      @id @default(autoincrement())
  usuarioId        Int?     @map("usuario_id")
  accion           String   @db.VarChar(50)
  modulo           String   @db.VarChar(50)
  tablaAfectada    String?  @map("tabla_afectada") @db.VarChar(50)
  registroId       Int?     @map("registro_id")
  detallesAnterior Json?    @map("detalles_anterior")
  detallesNuevo    Json?    @map("detalles_nuevo")
  ipOrigen         String?  @map("ip_origen") @db.VarChar(45)
  fechaHora        DateTime @default(now()) @map("fecha_hora") @db.Timestamp()

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("bitacora_auditoria")
}
